            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/members/{{memberId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "members", "{{memberId}}"] }
          }
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/members/{{memberId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "members", "{{memberId}}"] }
          }
