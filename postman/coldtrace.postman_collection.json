          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "services", "{{serviceId}}"] }
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "Create Incident",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.incident?.id) {",
                  "  pm.environment.set('incidentId', json.data.incident.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Payment Gateway Timeouts\",\n  \"description\": \"Intermittent HTTP 504 gateway timeouts observed during checkout.\",\n  \"severity\": \"HIGH\",\n  \"serviceIds\": [\"{{serviceId}}\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/incidents", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "incidents"] }
          }
        },
        {
          "name": "List Organization Incidents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/incidents?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "incidents"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Get Incident by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/incidents/{{incidentId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "incidents", "{{incidentId}}"] }
          }
        },
        {
          "name": "Update Incident",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"CRITICAL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/organizations/{{orgId}}/incidents/{{incidentId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{orgId}}", "incidents", "{{incidentId}}"] }
          }
        }
      ]
    },
